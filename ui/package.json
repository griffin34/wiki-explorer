    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "date-fns": "^3.3.1",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.344.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.1",
    "rehype-highlight": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "ws": "^8.16.0"
