{
  "name": "wiki-explorer-ui",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,ui -c cyan,magenta \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "node --import tsx server/index.ts",
