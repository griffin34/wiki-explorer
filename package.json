{
  "name": "wiki-explorer-ui",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n server,ui -c cyan,magenta \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "cross-env NODE_ENV=development node --import tsx server/index.ts",
    "dev:ui": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "electron:dev": "concurrently -n server,ui,electron -c cyan,magenta,yellow \"npm run dev:server\" \"npm run dev:ui\" \"npm run electron:start\"",
    "electron:start": "tsc -p tsconfig.electron.json && npm run build:preload && electron .",
    "electron:build": "npm run build && tsc -p tsconfig.electron.json && npm run build:server && npm run build:preload && electron-builder",
    "electron:build:full": "npm run build:agent && npm run electron:build",
    "electron:build:mac": "npm run electron:build:full -- --mac",
    "electron:build:win": "npm run build:agent:win && npm run electron:build -- --win",
    "build:agent": "bash scripts/build-agent.sh",
    "build:agent:win": "powershell -ExecutionPolicy Bypass -File scripts/build-agent.ps1",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/index.cjs --external:fsevents",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=electron/preload.cjs --external:electron"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "date-fns": "^3.3.1",
    "express": "^4.18.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.344.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.1",
    "rehype-highlight": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.57",
    "@types/react-dom": "^18.2.19",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.9.0",
    "postcss": "^8.4.35",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vitest": "^4.1.7"
  }
}
